# MertOS — sunucu tarafı ortam değişkenleri. Hepsi YALNIZCA sunucuda durur.

# --- Asistan (Faz 1+) — ZORUNLU ---------------------------------------------
# Kolay yol: değişkenler yokken siteyi aç → /giris "Kurulum" ekranı aşağıdaki
# satırları senin için üretir, Vercel'e tek seferde yapıştırırsın.

# Turso (bulut SQLite) — https://app.turso.tech → veritabanı → Connect.
# Yerel geliştirmede file:./yerel.db kullanılabilir; canlıda (Vercel) yasak.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Tek şifrenin bcrypt hash'i (base64). /giris kurulum ekranı üretir.
APP_PASSWORD_HASH=
# Oturum çerezini imzalayan rastgele sır (en az 32 karakter).
SESSION_SECRET=
# Vercel Cron'un haftalık yedek uç noktasını çağırırken gönderdiği sır.
CRON_SECRET=

# Gemini API (ücretli, faturalandırması açık anahtar) — https://aistudio.google.com → Get API key.
# Olmadan da uygulama çalışır; sohbet "henüz kurulmadı" der.
GEMINI_API_KEY=
# Maliyet sigortası: Türkiye gününe göre en fazla kaç model çağrısı (varsayılan 200).
LLM_GUNLUK_SINIR=

# --- Eski: Bildirimler (KAPATILDI) ---------------------------------------------
# Görev dosyası § 15 gereği /api/push/* uç noktaları proxy.ts'te 410 döner.
# Aşağıdaki değişkenler artık kullanılmıyor; kod duruyor.

# Upstash Redis (REST) — abonelik/özet/gönderim-log depolama.
# https://console.upstash.com → Create database → REST API bölümünden kopyala.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push VAPID anahtar çifti — `npx web-push generate-vapid-keys` ile üret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sen@ornek.com

# VAPID_PUBLIC_KEY ile AYNI değer olmalı — istemci (tarayıcı) tarafında
# push aboneliği oluşturmak için kullanılır, bu yüzden NEXT_PUBLIC_ ön eki var.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

