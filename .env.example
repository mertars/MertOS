# MertOS — sunucu tarafı bildirim sistemi için ortam değişkenleri.
# Hiçbiri olmadan da uygulama tam çalışır (push bildirimleri sessizce
# devre dışı kalır, 503 döner) — bkz. README.md § Bildirimler.

# Upstash Redis (REST) — abonelik/özet/gönderim-log depolama.
# https://console.upstash.com → Create database → REST API bölümünden kopyala.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push VAPID anahtar çifti — `npx web-push generate-vapid-keys` ile üret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mertarslan30@outlook.com

# VAPID_PUBLIC_KEY ile AYNI değer olmalı — istemci (tarayıcı) tarafında
# push aboneliği oluşturmak için kullanılır, bu yüzden NEXT_PUBLIC_ ön eki var.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# /api/push/tick uç noktasını dış bir cron servisinin (örn. cron-job.org)
# çağırabilmesi için paylaşılan bir sır. Rastgele uzun bir string üret.
CRON_SECRET=

# AI Koç (/koc sekmesi) — https://console.anthropic.com üzerinden alınır.
# Olmadan da uygulama çalışır, sadece Koç "yapılandırılmamış" hatası verir.
ANTHROPIC_API_KEY=
